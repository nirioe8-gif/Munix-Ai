# GEMINI_API_KEY: Required for Gemini AI DJ Assistant, Admin AI Control, Gemini TTS Voices, and Lyria music generation (paid key).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HMAC session tokens (set a strong random string in production).
SESSION_SECRET="change-me-to-a-long-random-secret"

# ADMIN_EMAIL: Owner email granted administrator privileges upon signup.
ADMIN_EMAIL="nirioe8@gmail.com"

# MUSIC_PROVIDER: Active AI music generation provider ('lyria' | 'replicate' | 'custom')
MUSIC_PROVIDER="lyria"

# MUSIC_API_KEY & MUSIC_API_URL: Optional external AI music provider credentials (e.g., Suno/Udio/custom REST adapter).
MUSIC_API_KEY=""
MUSIC_API_URL=""

# REPLICATE_API_TOKEN: Optional Replicate API token for MusicGen and Demucs stem separation.
REPLICATE_API_TOKEN=""

# STEM_API_URL & STEM_API_KEY: Optional dedicated Demucs/Spleeter stem separation backend endpoint.
STEM_API_URL=""
STEM_API_KEY=""
